{
  "saveAndRun": {
    "commands": [
      {
        "cmd": " exp/run ${file}",
        "match": ".*/.*\\.lambda"
      },
      {
        "cmd": " python3 exp/iota-to-i.py `\\cat ${file}`",
        "match": ".*/.*\\.iota"
      },
      {
        "cmd": " node ${file}",
        "match": ".*/.*\\.run.js"
      }
    ]
  },
  "lambda.lsp.serverPath": "lambda",
  "lambda.lsp.debug.enable": true,
}