mod lambda;
mod parser;
mod search_combination;

use parser::parse;
use search_combination::{search_combination, SearchOptions};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    println!("=== X を組み合わせて K コンビネータを構成 ===\n");

    let x = parse(r"\x. \y. \z. x (\a. \b. a) z (y z)")?;
    let k = parse(r"\x.\y.x")?; // K コンビネータ
    let s = parse(r"\x.\y.\z.x z (y z)")?; // S コンビネータ
    let i = parse(r"\x.x")?; // I コンビネータ
    let target = s;

    let options = SearchOptions::progress_only();

    match search_combination(&x, &target, 60, 1000, &options) {
        Some(result) => {
            println!("\n========================================");
            println!("✓ 成功: {} 個の X で {} を構成できました", result.n, target);
            println!("========================================");
            println!("\n構成方法: {}", result.combination);
        }
        None => {
            println!("\n========================================");
            println!("✗ 失敗: 見つかりませんでした");
            println!("========================================");
        }
    }

    Ok(())
}
