{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lambda",
  "scopeName": "source.lambda",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.lambda",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lambda",
          "match": "\\b(reduce|reduce_steps|assert|search|include|from|import|as)\\b"
        },
        {
          "name": "keyword.operator.lambda",
          "match": "[\\\\λ]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lambda",
          "begin": "\"",
          "end": "\"",
          "escapes": {
            "match": "\\\\."
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lambda",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.lambda",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
